# =============================================================================
# Application Settings (Rule #9, #10, #21)
# =============================================================================

# Application environment classification
APP_ENV=local

# Application version (auto-detected from git if not set)
APP_VERSION=0.1.0

# Git SHA (auto-detected from git if not set)
GIT_SHA=

# =============================================================================
# Temporal Settings
# =============================================================================

# Point these at your existing Temporal Server
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=research-agent

# =============================================================================
# Langfuse Observability (Rules #2, #10, #18, #25)
# =============================================================================

# Get these from your Langfuse deployment
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...

# Local Langfuse URL (self-hosted or Docker)
LANGFUSE_BASE_URL=http://localhost:3000

# Environment label for Langfuse traces (separate from APP_ENV)
LANGFUSE_TRACING_ENVIRONMENT=local

# Sampling rate for traces (0.0 = none, 1.0 = all)
# For local prototype: 1.0. At scale, consider error-based sampling.
TRACING_SAMPLE_RATE=1.0

# =============================================================================
# Optional: LLM Provider Settings
# =============================================================================

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
