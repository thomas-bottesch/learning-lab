# Custom Forgejo Runner Image with Python 3.12
# This image extends the official Actions Runner with Python 3.12 support

FROM ghcr.io/actions/actions-runner:2.330.0

# Switch to root user for package installation
USER root

# Install Node.js 20 LTS from NodeSource (required for modern Actions)
RUN apt-get update && \
    apt-get install -y curl && \
    curl -fsSL https://deb.nodesource.com/setup_20.x | bash - && \
    add-apt-repository ppa:deadsnakes/ppa -y && \
    apt-get install -y nodejs

# Install Python 3.12 and dependencies
RUN apt-get update && \
    apt-get install -y software-properties-common lsb-release && \
    apt-get install -y \
    python3.12 \
    python3.12-venv \
    python3.12-dev \
    python3-pip \
    docker.io \
    jq \
    && rm -rf /var/lib/apt/lists/*

# Install uv (fast Python package manager)
RUN curl -LsSf https://astral.sh/uv/install.sh | sh && \
    /root/.local/bin/uv --version && \
    cp /root/.local/bin/uv /usr/local/bin/uv && \
    chmod +x /usr/local/bin/uv && \
    ln -sf /usr/local/bin/uv /usr/local/bin/pip && \
    ln -sf /usr/local/bin/uv /usr/local/bin/pip3

# Install ORAS 1.3.0 (OCI Registry As Storage)
RUN curl -LO https://github.com/oras-project/oras/releases/download/v1.3.0/oras_1.3.0_linux_amd64.tar.gz && \
    mkdir -p /tmp/oras-install && \
    tar -zxf oras_1.3.0_linux_amd64.tar.gz -C /tmp/oras-install && \
    mv /tmp/oras-install/oras /usr/local/bin/oras && \
    chmod +x /usr/local/bin/oras && \
    rm -rf oras_1.3.0_linux_amd64.tar.gz /tmp/oras-install && \
    oras version

# Install yq v4 (mikefarah) — used in publish.yaml to extract .version from manifest.yaml.
# Must be mikefarah/yq (Go binary) — the `yq e '<expr>'` syntax used in the workflows is v4-specific.
RUN curl -Lo /usr/local/bin/yq \
    https://github.com/mikefarah/yq/releases/download/v4.44.3/yq_linux_amd64 && \
    chmod +x /usr/local/bin/yq && \
    yq --version

# Create symlinks for python and python3 to point to python3.12
# These need to be created as root
RUN ln -sf /usr/bin/python3.12 /usr/bin/python && \
    ln -sf /usr/bin/python3.12 /usr/bin/python3

# Create a venv owned by runner so CI jobs can install project packages into it
# without needing root. All heavyweight CI deps are pre-baked here to avoid
# per-job network downloads; runner can later do `uv pip install -e .` into it.
RUN uv venv /opt/ml-venv --python /usr/bin/python3.12 && \
    uv pip install --python /opt/ml-venv/bin/python \
        kfp \
        requests \
        pytest \
        pyyaml \
        packaging \
        build \
        twine && \
    chown -R runner:runner /opt/ml-venv

ENV PATH="/opt/ml-venv/bin:$PATH"

# Switch back to runner user
USER runner

# Verify all installations
RUN node --version && \
    python3.12 --version && \
    python --version && \
    uv --version && \
    git --version && \
    jq --version && \
    yq --version && \
    python -c "import kfp, requests, yaml, packaging, build, twine; print('Python packages OK')"

# Set working directory
WORKDIR /actions-runner

CMD ["/bin/bash"]
